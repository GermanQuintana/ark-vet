# ─────────────────────────────────────────────────────────────────────────────
# Configuración de acceso a ARK (servidor MCP).
#
# Opción recomendada en Windows/Codex:
#   npm run configure:windows
# Guarda la configuración de ese usuario en %APPDATA%\mcp-ark\.env.
#
# Compatibilidad con Claude/local: también puedes copiar este archivo a .env
# en la carpeta mcp-server/ y rellenarlo manualmente.
# NO subas ningún .env a git: contiene tu contraseña.
#
# El servidor no trae credenciales por defecto: sin estos datos no arranca.
# ─────────────────────────────────────────────────────────────────────────────

# URL base de la API de ARK. Puede ser distinta para cada empresa.
ARK_BASE_URL=https://ark.gestionveterinariaark.es/ark/rest

# Código del centro / empresa en ARK (el "tenant"). Es el identificador de tu
# clínica dentro de ARK. Si no lo sabes, pídelo al proveedor de ARK.
ARK_TENANT=

# Nombre de usuario con el que accedes a ARK.
ARK_USERNAME=

# Clave / contraseña de ese usuario.
ARK_PASSWORD=

# ── Opcional: solo para CREAR pedidos/compras (herramientas de escritura) ──────
# Si no los rellenas, las consultas (lectura) funcionan igual; solo se piden al
# crear pedidos/compras, y se pueden pasar en cada llamada.
#
# ARK_TERMINAL_ID  = id del terminal/caja. Descúbrelo con la herramienta
#                    ark_terminales.
# ARK_EMPLEADO_ID  = id del empleado (código de usuario). Descúbrelo con
#                    ark_empleado_por_clave pasando tu clave de empleado.
#ARK_TERMINAL_ID=
#ARK_EMPLEADO_ID=
