{
  "name": "mcp-ark",
  "version": "0.5.0",
  "description": "MCP server for ARK (Recevet) veterinary management system",
  "type": "module",
  "bin": {
    "mcp-ark": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/@vercel/ncc/dist/ncc/cli.js build src/index.ts -o dist -m --license licenses.txt",
    "bundle": "node ./node_modules/@vercel/ncc/dist/ncc/cli.js build src/index.ts -o dist -m --license licenses.txt",
    "start": "node dist/index.js",
    "test:smoke": "node ./scripts/smoke-test.mjs",
    "dev": "node ./node_modules/typescript/bin/tsc --watch",
    "configure:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/configure-ark.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "undici": "^8.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.44.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=24"
  }
}
